{
  "name": "strata",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sim": "tsx sim/sim.ts",
    "zip": "node scripts/zip.mjs",
    "prep-assets": "node tools/prep-assets.mjs",
